function y=TFD1(N)
    omegaN = exp((2*%i*%pi)/N);
    OMEGAN = zeros(N,N);
    for n=0:N-1
        for k=0:N-1
             OMEGAN(I(n),I(k)) =(omegaN)^(n*k);
        end 
    end 
    y=conj(OMEGAN)/N;  
endfunction
